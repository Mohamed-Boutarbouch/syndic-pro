{
  "name": "@syndic-pro/db",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "generate": "drizzle-kit generate",
    "migrate": "drizzle-kit migrate",
    "push": "drizzle-kit push",
    "pull": "drizzle-kit pull",
    "studio": "drizzle-kit studio",
    "check": "drizzle-kit check"
  },
  "exports": {
    ".": {
      "@syndic-pro/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./schema": {
      "@syndic-pro/source": "./src/schema/index.ts",
      "types": "./dist/schema/index.d.ts",
      "import": "./dist/schema/index.js",
      "default": "./dist/schema/index.js"
    },
    "./validators": {
      "@syndic-pro/source": "./src/validators/index.ts",
      "types": "./dist/validators/index.d.ts",
      "import": "./dist/validators/index.js",
      "default": "./dist/validators/index.js"
    },
    "./types": {
      "@syndic-pro/source": "./src/types/index.ts",
      "types": "./dist/types/index.d.ts",
      "import": "./dist/types/index.js",
      "default": "./dist/types/index.js"
    },
    "./client": {
      "@syndic-pro/source": "./src/client.ts",
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js",
      "default": "./dist/client.js"
    }
  },
  "dependencies": {
    "better-auth": "^1.6.29",
    "drizzle-orm": "^0.45.2",
    "pg": "^8.22.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/pg": "^8.20.4",
    "drizzle-kit": "^0.31.10"
  }
}
